      "authenticated_protected_control_plane_context",
      "immutable_authenticated_scope",
      "trusted_model_identity",
      "evaluation_policy_reference"
    ],
    "untrusted_context": [
      "prompts",
      "observations",
      "memory_content",
      "model_output",
      "tool_output",
      "request_payloads"
    ],
    "default_on_unknown_or_stale_fact": "deny"
  },
  "verification_boundary": {
    "planner_or_tool_success_is_goal_success": false,
    "independent_verifier_required_for_future_goal_success": true,
    "goal_transition_gate_is_sole_future_achieved_writer": true,
    "required_goal_success_fields": [
      "verification_method",
      "threshold",
      "evidence_requirements",
      "failure_behavior",
      "legal_effect_classification",
      "human_confirmation_requirement"
    ]
  },
  "acceptance": {
    "owner": "Protected Control Plane architecture owner",
    "required_disposition": ["accept", "replace", "reject"],
    "required_before_successor_implementation": true,
    "required_future_evidence": [
      "state_and_proposal_model",
      "authenticated_scope_identity_authority_policy_and_approval",
      "independent_verification_and_quiescence",
      "atomic_audit_recovery_and_concurrency",
      "positive_negative_scope_authority_and_failure_tests",
      "stage_exclusion_and_no_effect_tests"
    ]
  },
  "migrations_authorized": false,
  "runtime_enabled": false,
  "external_effects_enabled": false,
  "stage_release_authorized": false,
  "recognition_claim_authorized": false
