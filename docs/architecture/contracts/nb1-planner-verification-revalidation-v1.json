  "stage": "NB-1",
  "successor_tasks": ["S1-10.1", "S1-10.3", "S1-10.6"],
  "scope": {
    "permitted": [
      "recorded_or_synthetic_observations",
      "typed_internal_plan_proposals",
      "bounded_cognitive_checkpoints",
      "effect_free_serial_cognitive_cycle"
    ],
    "prohibited": [
      "protected_goal_or_action_state",
      "goal_or_action_transition_gate_runtime",
      "tool_or_executor_invocation",
      "external_effect_or_reconciliation",
      "authority_approval_policy_or_budget_creation",
      "active_model_mutation",
      "stage_release_recognition_or_production_autonomy_claim"
    ]
  },
  "trust_boundary": {
