{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neural-brain.invalid/contracts/protected-storage-metadata-v1.schema.json",
  "title": "Protected storage metadata binding",
  "description": "Strict immutable metadata that binds one protected record to an exact ALLOW decision without containing the protected value.",
  "x-neural-brain-preparation-boundary": {
    "runtime_enabled": false,
    "allow_authorized": false,
    "composition_required": true,
    "statement": "This schema validates a future persisted binding shape only. A structural ALLOW reference is not authority without the separately accepted and active runtime composition."
  },
  "type": "object",
  "required": [
    "contract_version",
    "governance_binding_id",
    "scope",
    "protected_record",
    "data_object_type",
    "security_classification",
    "protected_data_classification",
    "purpose",
    "processing_activity",
    "data_subject_binding",
    "source_evidence_refs",
    "retention_policy",
    "retention_state",
    "protection_profile",
    "processing_policy",
    "decision",
    "approval_set_digest",
    "evidence_set_digest",
    "recorded_at"
  ],
  "properties": {
    "contract_version": {"const": "protected-storage-metadata-v1"},
    "governance_binding_id": {"$ref": "#/$defs/OpaqueId"},
    "scope": {"$ref": "#/$defs/SessionScope"},
    "protected_record": {
      "type": "object",
      "required": ["record_kind", "record_id", "record_version", "record_digest"],
      "properties": {
        "record_kind": {"enum": ["observation", "working_context_version", "checkpoint", "memory_candidate", "cognitive_transition_evidence"]},
        "record_id": {"$ref": "#/$defs/OpaqueId"},
        "record_version": {"type": "integer", "minimum": 1},
        "record_digest": {"$ref": "#/$defs/Digest"}
      },
      "additionalProperties": false
    },
    "data_object_type": {"$ref": "#/$defs/VersionedRef"},
    "security_classification": {"enum": ["public", "internal", "confidential", "restricted"]},
    "protected_data_classification": {"$ref": "#/$defs/DigestedRef"},
    "purpose": {"$ref": "#/$defs/VersionedRef"},
    "processing_activity": {"$ref": "#/$defs/VersionedRef"},
    "data_subject_binding": {"$ref": "#/$defs/DataSubjectBinding"},
    "source_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/EvidenceRef"}
    },
    "retention_policy": {"$ref": "#/$defs/DigestedRef"},
    "retention_state": {
      "type": "object",
      "required": ["evaluation_id", "starts_at", "expires_at", "legal_hold", "deletion_owner_id", "evaluated_at"],
      "properties": {
        "evaluation_id": {"$ref": "#/$defs/OpaqueId"},
        "starts_at": {"$ref": "#/$defs/Timestamp"},
        "expires_at": {"$ref": "#/$defs/Timestamp"},
        "legal_hold": {"type": "boolean"},
        "deletion_owner_id": {"$ref": "#/$defs/OpaqueId"},
        "evaluated_at": {"$ref": "#/$defs/Timestamp"}
      },
      "additionalProperties": false
    },
    "protection_profile": {"$ref": "#/$defs/DigestedRef"},
    "processing_policy": {"$ref": "#/$defs/DigestedRef"},
    "decision": {
      "type": "object",
      "required": ["decision_id", "decision_digest", "outcome"],
      "properties": {
        "decision_id": {"$ref": "#/$defs/OpaqueId"},
        "decision_digest": {"$ref": "#/$defs/Digest"},
        "outcome": {"const": "ALLOW"}
      },
      "additionalProperties": false
    },
    "approval_set_digest": {"$ref": "#/$defs/Digest"},
    "evidence_set_digest": {"$ref": "#/$defs/Digest"},
    "recorded_at": {"$ref": "#/$defs/Timestamp"}
  },
  "additionalProperties": false,
  "$defs": {
    "OpaqueId": {"type": "string", "minLength": 1, "maxLength": 128},
    "Digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "SessionScope": {
      "type": "object",
      "required": ["tenant_id", "area_id", "project_id", "session_id"],
      "properties": {
        "tenant_id": {"$ref": "#/$defs/OpaqueId"},
        "area_id": {"$ref": "#/$defs/OpaqueId"},
        "project_id": {"$ref": "#/$defs/OpaqueId"},
        "session_id": {"$ref": "#/$defs/OpaqueId"}
      },
      "additionalProperties": false
    },
    "VersionedRef": {
      "type": "object",
      "required": ["reference_id", "reference_version"],
      "properties": {
        "reference_id": {"$ref": "#/$defs/OpaqueId"},
        "reference_version": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "DigestedRef": {
      "type": "object",
      "required": ["reference_id", "reference_version", "reference_digest"],
      "properties": {
        "reference_id": {"$ref": "#/$defs/OpaqueId"},
        "reference_version": {"type": "integer", "minimum": 1},
        "reference_digest": {"$ref": "#/$defs/Digest"}
      },
      "additionalProperties": false
    },
    "EvidenceRef": {
      "type": "object",
      "required": ["record_contract", "evidence_id", "evidence_version", "evidence_digest"],
      "properties": {
        "record_contract": {"const": "privacy-evidence-record-v1"},
        "evidence_id": {"$ref": "#/$defs/OpaqueId"},
        "evidence_version": {"type": "integer", "minimum": 1},
        "evidence_digest": {"$ref": "#/$defs/Digest"}
      },
      "additionalProperties": false
    },
    "DataSubjectBinding": {
      "oneOf": [
        {
          "type": "object",
          "required": ["binding_mode"],
          "properties": {"binding_mode": {"const": "not_applicable"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["binding_mode", "subject_reference_id", "subject_reference_digest"],
          "properties": {
            "binding_mode": {"enum": ["individual_reference", "subject_group_reference"]},
            "subject_reference_id": {"$ref": "#/$defs/OpaqueId"},
            "subject_reference_digest": {"$ref": "#/$defs/Digest"}
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
